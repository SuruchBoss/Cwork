enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

/// Login identity. Separate from `Employee` on purpose: recruiters, auditors and
/// integration accounts need access without being on payroll, and an employee
/// record must survive long after its login is disabled.
model User {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email             String
  emailVerifiedAt   DateTime?
  phone             String?
  /// Argon2id. Null for SSO-only accounts.
  passwordHash      String?
  passwordChangedAt DateTime?
  /// Set when an admin forces a reset; all sessions issued before this are rejected.
  sessionsValidFrom DateTime @default(now())
  status            UserStatus @default(INVITED)
  mfaEnabled        Boolean  @default(false)
  /// AES-256-GCM envelope, decrypted only inside the MFA service.
  mfaSecretEnc      String?
  /// SHA-256 digests of unused recovery codes; a code is removed once spent.
  mfaRecoveryCodes  String[] @default([])
  mfaEnrolledAt     DateTime?
  /// Newest TOTP step already accepted, so a code cannot be replayed inside its
  /// own 90-second window.
  mfaLastUsedStep   Int?
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  locale            String   @default("th")
  timezone          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  employee              Employee?
  roles                 UserRole[]
  sessions              Session[]
  passwordResets        PasswordResetToken[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  deviceTokens          DeviceToken[]
  approvalTasks         ApprovalTask[]        @relation("ApprovalTaskApprover")
  delegatedTasks        ApprovalTask[]        @relation("ApprovalTaskDelegate")
  approvalInstances     ApprovalInstance[]
  policyStepTargets     ApprovalPolicyStep[]
  assistantConversations AssistantConversation[]
  uploadedFiles         FileObject[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

/// Permissions are string constants (see `src/core/security/permissions.ts`) held in
/// an array rather than a join table: the set is small, read on every request and
/// always needed in full.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  permissions    String[] @default([])
  /// System roles cannot be renamed or deleted through the API.
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users      UserRole[]
  policySteps ApprovalPolicyStep[]

  @@unique([organizationId, key])
  @@map("roles")
}

model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String   @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Optional scope: a role granted only over one department's employees.
  departmentId String?  @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  grantedAt    DateTime @default(now())
  grantedById  String?  @db.Uuid
  expiresAt    DateTime?

  @@unique([userId, roleId, departmentId])
  @@index([userId])
  @@map("user_roles")
}

/// One row per refresh-token family member. Rotation is enforced: presenting a
/// token whose `rotatedToId` is already set revokes the entire family (reuse detection).
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the refresh token. The raw token is never stored.
  tokenHash      String   @unique
  familyId       String   @db.Uuid
  rotatedToId    String?  @db.Uuid
  deviceId       String?
  deviceName     String?
  platform       String?
  ipAddress      String?
  userAgent      String?
  issuedAt       DateTime @default(now())
  expiresAt      DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedReason  String?

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
  LOGIN
  LOGIN_FAILED
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  PERMISSION_CHANGE
  AI_TOOL_CALL
}

/// Append-only. Nothing in the API updates or deletes these rows.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?  @db.Uuid
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         AuditAction
  entityType     String
  entityId       String?
  summary        String?
  /// Field-level diff; sensitive values are redacted before write.
  changes        Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

enum FileVisibility {
  PRIVATE
  ORGANIZATION
  PUBLIC
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

model FileObject {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket         String
  objectKey      String
  filename       String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String?
  visibility     FileVisibility @default(PRIVATE)
  scanStatus     FileScanStatus @default(PENDING)
  uploadedById   String?  @db.Uuid
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  employeeDocuments EmployeeDocument[]
  expenseItems      ExpenseClaimItem[]
  documentRequests  DocumentRequest[]
  knowledgeDocuments KnowledgeDocument[]

  @@unique([bucket, objectKey])
  @@index([organizationId, createdAt])
  @@map("file_objects")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  body           String
  data           Json     @default("{}")
  channel        NotificationChannel @default(IN_APP)
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  deviceId   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}

/// Transactional outbox: domain events are written in the same transaction as the
/// state change, then relayed by a worker. Keeps notifications/webhooks consistent.
model OutboxEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  occurredAt     DateTime @default(now())
  processedAt    DateTime?
  attempts       Int      @default(0)
  lastError      String?

  @@index([processedAt, occurredAt])
  @@map("outbox_events")
}
