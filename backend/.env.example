# ---------------------------------------------------------------------------
# Cwork — backend environment
# Copy to `.env` and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list. Must be explicit in production — no wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://cwork:cwork@localhost:5432/cwork?schema=public

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=cwork
JWT_AUDIENCE=cwork-clients

# 32-byte key, base64. Encrypts national IDs, bank accounts, MFA secrets.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ---- Security ----
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Where rate-limit counters live. `memory` is right for a single instance and
# quietly wrong for several: N replicas hand out N times the budget, and a
# restart forgets every counter. `postgres` shares them through the database
# that is already there, at the cost of one round-trip per request.
# The API says which one is in use at every boot.
THROTTLE_STORAGE=memory

# The longest a scheduled task may hold its cross-instance lock. Every replica
# runs the same cron schedule, so each job takes a Postgres advisory lock first
# and the rest stand down — nothing to switch on. The lock lives inside a
# transaction, so this also bounds how long that transaction stays open; a job
# that runs past it loses the lock and says so in the log. Raise it for an
# organisation large enough that the nightly close-out takes longer.
JOB_LOCK_TIMEOUT_MS=900000

# The outbox relay. Domain events are written in the same transaction as the
# change that caused them, then delivered from here — so nothing is sent for
# work that rolled back, and nothing is lost because the process died just
# after committing. Every instance polls: the claim uses FOR UPDATE SKIP
# LOCKED, so they take different rows rather than the same ones.
# 0 switches dispatch off on this instance.
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
# Failures before an event is parked as a dead letter. Dead letters are kept,
# never purged: the row is the only record that a message was owed and missed.
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETENTION_DAYS=14
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Requests per minute allowed against the credential endpoints (sign-in, MFA
# verify and enrolment). Far tighter than the global limit on purpose; raise it
# only for a deployment behind a shared egress address.
AUTH_THROTTLE_LIMIT=10

# Seconds a half-finished sign-in stays resumable between password and second
# factor. Long enough to fetch a code, short enough not to be an open door.
MFA_CHALLENGE_TTL=300

# ---- Storage (S3 compatible: MinIO in dev) ----

# --- Malware scanning ---------------------------------------------------------
# Uploads are streamed to clamd before they are stored. Off by default because
# it needs a clamd to talk to; the API says which mode it is in at boot, so a
# deployment can never quietly believe it is scanning when it is not.
#
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# A scan that does not finish in time leaves the file held, not passed.
CLAMAV_TIMEOUT_MS=15000

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cwork
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ---- AI assistant ----
# Leave ASSISTANT_ENABLED=false to run the whole HRIS without any AI provider.
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
ASSISTANT_MAX_TOKENS=1500
ASSISTANT_EMBEDDING_PROVIDER=none
ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Daily per-user caps; the request is rejected once either is exceeded.
ASSISTANT_DAILY_MESSAGE_LIMIT=100
ASSISTANT_DAILY_TOKEN_LIMIT=200000

# ---- Observability ----
LOG_LEVEL=debug
LOG_PRETTY=true

# ---- Localisation ----
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_LOCALE=th
DEFAULT_CURRENCY=THB
