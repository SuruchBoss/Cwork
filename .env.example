# ---------------------------------------------------------------------------
# docker compose configuration. Copy to `.env` and fill in every value marked
# REQUIRED — compose refuses to start without them, on purpose.
#
# Generate secrets with:
#   openssl rand -base64 48   # JWT secrets
#   openssl rand -base64 32   # FIELD_ENCRYPTION_KEY (must decode to 32 bytes)
# ---------------------------------------------------------------------------

NODE_ENV=production

# ---- Database ----
POSTGRES_USER=marma
POSTGRES_PASSWORD=          # REQUIRED
POSTGRES_DB=marma_hris

# ---- Secrets (REQUIRED — the API refuses to boot with placeholders) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts national IDs, bank accounts and MFA secrets at rest.
# Losing this key makes those columns permanently unreadable. Back it up.
FIELD_ENCRYPTION_KEY=

# ---- Networking ----
API_PORT=3000
WEB_PORT=8080
# Exact origins only — no wildcards. The API refuses to start with one in production.
CORS_ORIGINS=http://localhost:8080

# ---- Localisation ----
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_CURRENCY=THB

# ---- AI assistant (entirely optional) ----
# The whole HRIS works with ASSISTANT_ENABLED=false. Turning it on sends HR
# policy text and the employee's own data to your chosen model provider.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=none
ASSISTANT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

LOG_LEVEL=info
