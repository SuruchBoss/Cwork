# ---------------------------------------------------------------------------
# docker compose configuration. Copy to `.env` and fill in every value marked
# REQUIRED — compose refuses to start without them, on purpose.
#
# Generate secrets with:
#   openssl rand -base64 48   # JWT secrets
#   openssl rand -base64 32   # FIELD_ENCRYPTION_KEY (must decode to 32 bytes)
# ---------------------------------------------------------------------------

NODE_ENV=production

# ---- Database ----
POSTGRES_USER=cwork
POSTGRES_PASSWORD=          # REQUIRED
POSTGRES_DB=cwork

# ---- Secrets (REQUIRED — the API refuses to boot with placeholders) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts national IDs, bank accounts and MFA secrets at rest.
# Losing this key makes those columns permanently unreadable. Back it up.
FIELD_ENCRYPTION_KEY=

# ---- Networking ----
API_PORT=3000
WEB_PORT=8080
# Exact origins only — no wildcards. The API refuses to start with one in production.
CORS_ORIGINS=http://localhost:8080

# ---- Localisation ----
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_CURRENCY=THB

# ---- AI assistant (entirely optional) ----
# The whole HRIS works with ASSISTANT_ENABLED=false. Turning it on sends HR
# policy text and the employee's own data to your chosen model provider.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=none
ASSISTANT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

LOG_LEVEL=info

# --- Malware scanning ---------------------------------------------------------
# Uploads are streamed to clamd before they are stored. Off by default because
# it needs a clamd to talk to; the API says which mode it is in at boot, so a
# deployment can never quietly believe it is scanning when it is not.
#
# With Docker: `docker compose --profile av up -d` starts one, then set
#   MALWARE_SCAN_ENABLED=true
#   CLAMAV_HOST=clamav
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# A scan that does not finish in time leaves the file held, not passed.
CLAMAV_TIMEOUT_MS=15000

# Where rate-limit counters live. `memory` is right for a single instance and
# quietly wrong for several: N replicas hand out N times the budget, and a
# restart forgets every counter. `postgres` shares them through the database
# that is already there, at the cost of one round-trip per request.
# The API says which one is in use at every boot.
THROTTLE_STORAGE=memory

# The longest a scheduled task may hold its cross-instance lock. Every replica
# runs the same cron schedule, so each job takes a Postgres advisory lock first
# and the rest stand down — nothing to switch on. The lock lives inside a
# transaction, so this also bounds how long that transaction stays open; a job
# that runs past it loses the lock and says so in the log. Raise it for an
# organisation large enough that the nightly close-out takes longer.
JOB_LOCK_TIMEOUT_MS=900000

# The outbox relay. Domain events are written in the same transaction as the
# change that caused them, then delivered from here — so nothing is sent for
# work that rolled back, and nothing is lost because the process died just
# after committing. Every instance polls: the claim uses FOR UPDATE SKIP
# LOCKED, so they take different rows rather than the same ones.
# 0 switches dispatch off on this instance.
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
# Failures before an event is parked as a dead letter. Dead letters are kept,
# never purged: the row is the only record that a message was owed and missed.
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Notification delivery
# ---------------------------------------------------------------------------
# Off by default, because there is no sensible default relay and a deployment
# must never quietly believe it is sending mail. The API says which mode it is
# in at every boot. Delivery runs from the outbox, so a failed send is retried
# on the backoff above and never blocks the request that caused it.

EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
# `starttls` upgrades a plain connection and refuses to continue if the server
# does not offer it; `tls` is implicit TLS (port 465); `none` is for a relay on
# localhost and nothing else.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@cwork.local
SMTP_FROM_NAME=Cwork
SMTP_TIMEOUT_MS=15000

# Where links in an email point. An email that says something is waiting but
# not where is an email that may as well not have been sent.
PUBLIC_WEB_URL=http://localhost:8080

# Push through Firebase Cloud Messaging's HTTP v1 API. iOS goes through FCM
# too, so there is no separate APNs configuration. The private key is the one
# from the service-account JSON, with its newlines written as \n.
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
