# This is a picture of what install.sh writes into .env. Do NOT copy it to .env:
# install.sh makes the secrets itself, so no one has to invent them.

CWORK_MODE=full                      # full | db | app (db and app only for path C)
CWORK_VERSION=local                  # set by images.version when a bundle is used
CWORK_HOST=192.168.1.20              # the address staff type; the certificate is made for it
CWORK_HTTPS_PORT=8443                # the only port Cwork opens
PUBLIC_WEB_URL=https://192.168.1.20:8443

POSTGRES_PASSWORD=                   # random, 48 hex characters
# DB_HOST=                           # path C, on the PC only: the NAS's address
# DB_BIND=                           # path C, on the NAS only: the address 5432 is offered on

JWT_ACCESS_SECRET=                   # random
JWT_REFRESH_SECRET=                  # random
FIELD_ENCRYPTION_KEY=                # random. LOSE THIS AND ID/BANK DATA IS UNREADABLE FOREVER.
                                     # Keep it in a password manager (./show-key.sh), never in the backup folder.

CWORK_BACKUP_DIR=/volumeUSB1/usbshare/cwork-backup   # must be ANOTHER disk than Docker's data
CWORK_BACKUP_KEEP_DAYS=14

# Optional: DEFAULT_TIMEZONE=Asia/Bangkok  POSTGRES_MEM_LIMIT=1g  API_MEM_LIMIT=768m
